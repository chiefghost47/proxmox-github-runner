# inputs.env — copy to inputs.env and fill in. Lives on the workstation that drives the build.
# Every value here is an example. inputs.env itself is git-ignored.
# Addresses are arbitrary RFC 1918 examples, not a real network; the private-range block lists in the scripts are policy, keep them.

# Repositories that get a runner, space-separated. Private repos only: a self-hosted
# runner on a public repo executes code from any fork's pull request.
REPOS="yourname/repo-one yourname/repo-two"

# --- CI VLAN (built on the switch, the hypervisor bridge and the firewall before this runs) ---
VLAN_TAG=90
CI_SUBNET=10.90.0.0/24
CI_GW=10.90.0.1          # the firewall's address on the CI VLAN
VM_IP=10.90.0.10
CI_PREFIX=24
DNS_SERVERS="1.1.1.1 9.9.9.9"       # public resolvers, so the private-range block can stay first
NTP_SERVERS="162.159.200.1 162.159.200.123"   # public NTP (time.cloudflare.com); same reason

# --- VM ---
VM_NAME=ci-runner-01
STORAGE=local-zfs        # a ZFS pool or storage id on the Proxmox host
MEMORY_MB=4096           # fixed; the create script sets balloon 0
CORES=4
DISK_GB=48

# --- access ---
ADMIN_HOST=10.0.0.5                          # the one LAN host allowed to ssh to the runner (through the hypervisor)
ADMIN_CIDRS="10.0.0.5"                       # same, for the in-VM firewall
VM_SSH_KEY="$HOME/.ssh/ci-runner-admin"      # private key never leaves the workstation
GITHUB_PAT_FILE="$HOME/.ci-runner-pat"       # fine-grained PAT, short expiry; never copied to the host or the VM
PVE_SSH=proxmox                              # ~/.ssh/config alias for root on the Proxmox host
PFSENSE_SSH=firewall                         # ~/.ssh/config alias for the firewall (read-only use)

# --- verification: LAN targets the runner must NOT reach (host:port) ---
OUTER_PROBES="10.0.0.2:8006 10.0.0.2:22 10.0.0.20:1514 10.0.0.21:9200 10.0.0.1:443"
VERIFY_LAN_TARGET=10.0.0.2:8006

# --- optional SIEM agent on the runner VM; leave empty to skip ---
WAZUH_MANAGER=
WAZUH_VERSION=
